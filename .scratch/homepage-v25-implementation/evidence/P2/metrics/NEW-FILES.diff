diff --git a/app/components/homepage-v25/metric-cards.tsx b/app/components/homepage-v25/metric-cards.tsx
new file mode 100644
index 00000000..4926f05b
--- /dev/null
+++ b/app/components/homepage-v25/metric-cards.tsx
@@ -0,0 +1,161 @@
+"use client";
+
+import Decimal from "decimal.js";
+import { useEffect, useId, useLayoutEffect, useRef, useState } from "react";
+import { createPortal } from "react-dom";
+import type { HomepageV25Metric } from "../../lib/reviews/homepage-v25-performance";
+import type { HomepageV25SeriesBundle } from "../../lib/reviews/homepage-v25-series";
+import "./metric-cards.css";
+
+export type MetricCardsProps = Readonly<{
+  /** Host supplies one committed generation, including during pending/error. No local data cache. */
+  series: Readonly<HomepageV25SeriesBundle> | null;
+  reportCurrency: string;
+  status: Readonly<{ kind: "ready" }> | Readonly<{ kind: "pending" | "error" | "empty"; reason: string }>;
+}>;
+
+const CARDS = [
+  { key: "net", label: "期间净盈亏", definition: "期间已实现，加上期末与期初浮盈的差额。期间净盈亏 = 期间已实现 + 期末浮盈 − 期初浮盈。", signed: true },
+  { key: "periodRealized", label: "期间已实现", definition: "按实际平仓日归属、扣除费用的已实现结果；部分平仓逐笔按平仓日期和金额归属。", signed: true },
+  { key: "unrealizedChange", label: "期间浮盈变动", definition: "期末浮盈减期初浮盈，表示所选期间的浮盈变化。", signed: true },
+  { key: "currentMarketValue", label: "当前持仓市值", definition: "最新可用行情下的当前持仓市值，独立于所选期间；不随期间切换。", signed: false },
+] as const;
+type MetricKey = typeof CARDS[number]["key"];
+type Selection = { key: MetricKey; generation: string | null; sourceId: string | null; currency: string };
+type Readout = { metric: HomepageV25Metric | undefined; raw: string | null; reasons: string[] };
+const unique = (items: readonly string[]) => [...new Set(items.filter(Boolean))];
+
+/** Presentation consistency only. B remains the authority for amount availability. */
+function readout(metric: HomepageV25Metric | undefined, reportCurrency: string, unavailable?: string): Readout {
+  const mismatch = metric !== undefined && metric.money.targetCurrency !== reportCurrency;
+  return { metric: unavailable ? undefined : metric, raw: !unavailable && !mismatch && metric?.available ? metric.value : null,
+    reasons: unique([...(metric?.reasons ?? []), ...(unavailable ? [unavailable] : []),
+      ...(mismatch ? ["币种与报表不一致"] : []),
+      ...(!unavailable && !metric ? ["当前范围没有可计算指标"] : []),
+      ...(!unavailable && metric && (!metric.available || metric.value === null) && !metric.reasons.length ? ["金额未知"] : [])]) };
+}
+
+// Unit scaling and rounding are display formatting only; detail retains the exact source string.
+function formatPrimary(raw: string, signed: boolean): { number: string; unit: string; tone: string } {
+  const amount = new Decimal(raw);
+  const unit = amount.abs().gte(100_000_000) ? "亿" : amount.abs().gte(10_000) ? "万" : "";
+  const shown = unit === "亿" ? amount.div(100_000_000) : unit === "万" ? amount.div(10_000) : amount;
+  const formatted = shown.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
+  return { number: `${signed && amount.gt(0) ? "+" : ""}${formatted}`, unit,
+    tone: !signed || amount.isZero() ? "neutral" : amount.gt(0) ? "positive" : "negative" };
+}
+
+function MetricEvidence({ read, currency }: { read: Readout; currency: string }) {
+  const metric = read.metric;
+  return <>
+    <dl className="hp-metric-cards__facts">
+      <dt>完整金额</dt><dd>{read.raw === null ? "—" : `${read.raw} ${currency}`}</dd>
+      <dt>覆盖数量</dt><dd>{metric ? `${metric.coverage.available} / ${metric.coverage.total}` : "—"}</dd>
+      <dt>原币金额</dt><dd>{metric && Object.keys(metric.money.originalByCurrency).length
+        ? Object.entries(metric.money.originalByCurrency).map(([code, amount]) => <span key={code}>{amount} {code}</span>) : "未提供原币金额"}</dd>
+      <dt>汇率来源</dt><dd>{metric?.money.fx ? <>
+        <span>{metric.money.fx.source}</span><span>{metric.money.fx.asOf} · {metric.money.fx.id} · {metric.money.fx.status}</span>
+      </> : metric?.money.conversion === "same-currency" ? "同币种，无需换汇" : "未提供汇率来源"}</dd>
+      {metric?.value !== null && metric?.value !== undefined && read.raw === null && <>
+        <dt>来源金额</dt><dd>{metric.value} {metric.money.targetCurrency ?? "币种未知"}</dd>
+      </>}
+    </dl>
+    {read.reasons.length > 0 && <ul className="hp-metric-cards__reasons">{read.reasons.map(reason => <li key={reason}>{reason}</li>)}</ul>}
+  </>;
+}
+
+export function MetricCards({ series, reportCurrency, status }: MetricCardsProps) {
+  const id = useId();
+  const [selection, setSelection] = useState<Selection | null>(null);
+  const triggers = useRef<Partial<Record<MetricKey, HTMLButtonElement | null>>>({});
+  const dialog = useRef<HTMLDivElement>(null);
+  const previousOpen = useRef<MetricKey | null>(null);
+  const [position, setPosition] = useState({ left: 24, top: 24 });
+  const active = selection && selection.generation === (series?.requestGeneration ?? null)
+    && selection.sourceId === (series?.sourceId ?? null) && selection.currency === reportCurrency ? selection.key : null;
+  const definition = CARDS.find(card => card.key === active);
+  const unavailablePeriod = status.kind === "empty" ? status.reason
+    : series?.summaryState === "future" || series?.periodSummary?.state === "future" ? "未来未覆盖，金额未知" : undefined;
+  const read = (key: MetricKey) => readout(key === "currentMarketValue" ? series?.current.currentMarketValue : series?.periodSummary?.[key],
+    reportCurrency, key === "currentMarketValue" ? status.kind === "empty" ? status.reason : undefined : unavailablePeriod);
+
+  useLayoutEffect(() => {
+    if (active) dialog.current?.focus();
+    else if (previousOpen.current) triggers.current[previousOpen.current]?.focus();
+    previousOpen.current = active;
+  }, [active]);
+
+  useLayoutEffect(() => {
+    if (!active) return;
+    function place() {
+      const anchor = triggers.current[active!]?.getBoundingClientRect();
+      const panel = dialog.current?.getBoundingClientRect();
+      if (!anchor || !panel) return;
+      const width = document.documentElement.clientWidth || window.innerWidth;
+      const height = document.documentElement.clientHeight || window.innerHeight;
+      const top = anchor.bottom + 8 + panel.height <= height - 24 ? anchor.bottom + 8 : Math.max(24, anchor.top - panel.height - 8);
+      setPosition({ left: Math.max(24, Math.min(anchor.left, width - panel.width - 24)), top });
+    }
+    place();
+    const observer = typeof ResizeObserver === "undefined" ? null : new ResizeObserver(place);
+    if (dialog.current) observer?.observe(dialog.current);
+    window.addEventListener("resize", place);
+    window.addEventListener("scroll", place, true);
+    return () => { observer?.disconnect(); window.removeEventListener("resize", place); window.removeEventListener("scroll", place, true); };
+  }, [active, series, status, reportCurrency]);
+
+  useEffect(() => {
+    if (!active) return;
+    function onKey(event: KeyboardEvent) { if (event.key === "Escape") { event.preventDefault(); setSelection(null); } }
+    function onOutside(event: MouseEvent) {
+      const target = event.target;
+      if (!(target instanceof Node) || dialog.current?.contains(target) || Object.values(triggers.current).some(trigger => trigger?.contains(target))) return;
+      setSelection(null);
+    }
+    document.addEventListener("keydown", onKey);
+    document.addEventListener("click", onOutside);
+    return () => { document.removeEventListener("keydown", onKey); document.removeEventListener("click", onOutside); };
+  }, [active]);
+
+  const currentUnrealized = readout(series?.current.currentUnrealized, reportCurrency, status.kind === "empty" ? status.reason : undefined);
+  const contextReasons = active === "currentMarketValue" ? unique([
+    ...(series?.current.fxCoverage.reasons ?? []), ...Object.values(series?.current.quoteCoverage ?? {}).flatMap(item => item.reasons),
+  ]) : series?.periodSummary?.reasons ?? [];
+  return <section className="hp-metric-cards" aria-label="当前表现指标" aria-busy={status.kind === "pending"}>
+    <div className="hp-metric-cards__grid">
+      {CARDS.map(card => {
+        const amount = read(card.key);
+        const formatted = amount.raw === null ? { number: "—", unit: "", tone: "neutral" } : formatPrimary(amount.raw, card.signed);
+        return <article key={card.key} className="hp-metric-cards__card" aria-label={card.label}>
+          <h3 id={`${id}-${card.key}-label`}>{card.label}({reportCurrency})</h3>
+          {status.kind === "pending" && !series ? <div className="hp-metric-cards__skeleton" data-testid="hp-metric-skeleton" aria-label="金额加载中" />
+            : <p className={`hp-metric-cards__value hp-metric-cards__value--${formatted.tone}`} data-testid="hp-metric-value" data-tone={formatted.tone}>
+              <span className="hp-metric-cards__number">{formatted.number}</span>{formatted.unit && <span className="hp-metric-cards__unit"> {formatted.unit}</span>}
+            </p>}
+          {status.kind === "pending" && series && <span className="hp-metric-cards__loading" aria-hidden="true">更新中</span>}
+          <button className="hp-metric-cards__trigger" type="button" ref={node => { triggers.current[card.key] = node; }}
+            aria-label={`${card.label}，${status.kind === "error" ? "查看原因" : "口径详情"}，${amount.raw === null ? "金额未知" : `完整金额 ${amount.raw} ${reportCurrency}`}`} aria-haspopup="dialog"
+            aria-expanded={active === card.key} aria-controls={active === card.key ? `${id}-detail` : undefined}
+            onClick={() => setSelection(active === card.key ? null : { key: card.key, generation: series?.requestGeneration ?? null, sourceId: series?.sourceId ?? null, currency: reportCurrency })}>
+            <span className={`hp-metric-cards__affordance${status.kind === "error" ? " hp-metric-cards__affordance--error" : ""}`}>
+              {status.kind === "error" ? "查看原因" : "口径详情"}
+            </span>
+          </button>
+        </article>;
+      })}
+    </div>
+    {status.kind !== "ready" && <p className={`hp-metric-cards__status hp-metric-cards__status--${status.kind}`} role="status">{status.reason}</p>}
+    {active && definition && createPortal(<div id={`${id}-detail`} ref={dialog} role="dialog" aria-modal="false"
+      aria-labelledby={`${id}-detail-title`} tabIndex={-1} className="hp-metric-cards__detail" style={position}>
+      <div className="hp-metric-cards__detail-header"><h4 id={`${id}-detail-title`}>{definition.label} · 口径详情</h4>
+        <button type="button" aria-label="关闭详情" onClick={() => setSelection(null)}>×</button></div>
+      <p>{definition.definition}</p>
+      <p className="hp-metric-cards__context">{active === "currentMarketValue" ? `当前时点 ${series?.current.asOf ?? "未知"}`
+        : series ? `期间 ${series.boundary.periodStart} 至 ${series.boundary.requestedEnd} · 上海时区` : "期间数据尚不可用"}</p>
+      {status.kind !== "ready" && <p className="hp-metric-cards__notice">{status.reason}</p>}
+      <MetricEvidence read={read(active)} currency={reportCurrency} />
+      {contextReasons.length > 0 && <ul className="hp-metric-cards__reasons">{unique(contextReasons).map(reason => <li key={reason}>{reason}</li>)}</ul>}
+      {active === "currentMarketValue" && <section aria-label="当前浮盈"><h5>当前浮盈</h5><MetricEvidence read={currentUnrealized} currency={reportCurrency} /></section>}
+    </div>, document.body)}
+  </section>;
+}

diff --git a/app/components/homepage-v25/metric-cards.css b/app/components/homepage-v25/metric-cards.css
new file mode 100644
index 00000000..0bec5437
--- /dev/null
+++ b/app/components/homepage-v25/metric-cards.css
@@ -0,0 +1,68 @@
+.hp-metric-cards {
+  container: hp-metrics / inline-size;
+  min-width: 0;
+  color: var(--hp-text, #e6edf7);
+  font: 14px/20px -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
+  font-variant-numeric: tabular-nums;
+}
+.hp-metric-cards__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
+.hp-metric-cards .hp-metric-cards__card {
+  box-sizing: border-box;
+  position: relative;
+  min-width: 0;
+  height: 88px;
+  padding: 12px 16px;
+  border: 1px solid var(--hp-line, #283448);
+  border-radius: 8px;
+  background: var(--hp-surface, #111a26);
+}
+.hp-metric-cards .hp-metric-cards__card h3 { margin: 0; color: var(--hp-secondary, #a8b6cb); font-family: inherit; font-size: 14px; font-weight: 400; line-height: 20px; }
+.hp-metric-cards .hp-metric-cards__value { display: flex; margin: 4px 0 0; font-size: 28px; font-weight: 600; line-height: 34px; white-space: nowrap; }
+.hp-metric-cards__number { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
+.hp-metric-cards__unit { flex: 0 0 auto; white-space: pre; }
+.hp-metric-cards__value--positive { color: #53d7a0; }
+.hp-metric-cards__value--negative { color: #ff8592; }
+.hp-metric-cards__value--neutral { color: var(--hp-text, #e6edf7); }
+.hp-metric-cards button.hp-metric-cards__trigger,
+.hp-metric-cards .hp-metric-cards__trigger:hover:not(:disabled),
+.hp-metric-cards .hp-metric-cards__trigger:active:not(:disabled) {
+  position: absolute; inset: 0; display: block; width: 100%; height: 100%; padding: 0; border: 0; border-radius: 8px; background: transparent; color: #6ca8ff; cursor: pointer; font: inherit;
+}
+.hp-metric-cards .hp-metric-cards__trigger:focus-visible { outline: 2px solid #a9c8ff; outline-offset: 2px; }
+.hp-metric-cards__affordance { position: absolute; right: 8px; bottom: 8px; padding: 2px 4px; border-radius: 4px; background: #162233; font-size: 12px; line-height: 20px; opacity: 0; transition: opacity 120ms ease, color 120ms ease; }
+.hp-metric-cards__trigger:hover .hp-metric-cards__affordance,
+.hp-metric-cards__trigger:focus-visible .hp-metric-cards__affordance,
+.hp-metric-cards__affordance--error { opacity: 1; }
+.hp-metric-cards__affordance--error { color: #ff8592; }
+.hp-metric-cards__skeleton { width: 60%; height: 28px; margin-top: 6px; border-radius: 4px; background: #283448; }
+.hp-metric-cards__loading { position: absolute; top: 7px; right: 10px; color: #a8b6cb; font-size: 12px; line-height: 16px; }
+.hp-metric-cards .hp-metric-cards__status { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
+.hp-metric-cards__detail,
+.hp-metric-cards__detail * { box-sizing: border-box; }
+.hp-metric-cards__detail {
+  position: fixed; z-index: 100; width: min(440px, calc(100vw - 48px)); max-height: calc(100dvh - 48px); overflow-y: auto; padding: 16px;
+  border: 1px solid #283448; border-radius: 8px; background: #162233; color: #e6edf7; box-shadow: 0 12px 32px #0006;
+  font: 14px/20px -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif; font-variant-numeric: tabular-nums; overflow-wrap: anywhere;
+  animation: hp-metric-detail-in 160ms ease-out;
+}
+.hp-metric-cards__detail:focus-visible { outline: 2px solid #a9c8ff; outline-offset: 2px; }
+.hp-metric-cards__detail-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
+.hp-metric-cards__detail h4 { margin: 0; font-size: 16px; line-height: 24px; font-weight: 600; }
+.hp-metric-cards__detail h5 { margin: 16px 0 8px; font-size: 14px; line-height: 20px; font-weight: 600; }
+.hp-metric-cards__detail p { margin: 8px 0; }
+.hp-metric-cards__detail .hp-metric-cards__context { color: #a8b6cb; font-size: 12px; line-height: 20px; }
+.hp-metric-cards__detail-header button { flex: 0 0 36px; width: 36px; height: 36px; margin-top: -8px; margin-right: -8px; padding: 0; border: 0; border-radius: 6px; color: #a8b6cb; background: transparent; font-size: 24px; cursor: pointer; }
+.hp-metric-cards__detail-header button:hover { color: #e6edf7; background: #1c2b42; }
+.hp-metric-cards__detail-header button:focus-visible { outline: 2px solid #a9c8ff; outline-offset: 2px; }
+.hp-metric-cards__facts { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 8px 12px; margin: 12px 0 0; }
+.hp-metric-cards__facts dt { color: #a8b6cb; }
+.hp-metric-cards__facts dd { min-width: 0; margin: 0; text-align: right; }
+.hp-metric-cards__facts dd span { display: block; }
+.hp-metric-cards__reasons { margin: 12px 0 0; padding-left: 18px; color: #a8b6cb; }
+.hp-metric-cards__notice { color: #a8b6cb; }
+/* Four readable baseline cards require 4×240px + 3×12px; two require 2×240px + 12px. */
+@container hp-metrics (width < 996px) { .hp-metric-cards__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+@container hp-metrics (width < 492px) { .hp-metric-cards__grid { grid-template-columns: minmax(0, 1fr); } }
+@media (pointer: coarse) { .hp-metric-cards__detail-header button { flex-basis: 44px; width: 44px; height: 44px; } }
+@keyframes hp-metric-detail-in { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
+@media (prefers-reduced-motion: reduce) { .hp-metric-cards__affordance { transition: none; } .hp-metric-cards__detail { animation: none; } }

diff --git a/app/components/homepage-v25/metric-cards.test.tsx b/app/components/homepage-v25/metric-cards.test.tsx
new file mode 100644
index 00000000..716852e2
--- /dev/null
+++ b/app/components/homepage-v25/metric-cards.test.tsx
@@ -0,0 +1,227 @@
+import { cleanup, render, screen, within } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { afterEach, describe, expect, it } from "vitest";
+import type { HomepageV25BoundaryPoint, HomepageV25Metric } from "../../lib/reviews/homepage-v25-performance";
+import type { HomepageV25SeriesBundle } from "../../lib/reviews/homepage-v25-series";
+import { MetricCards } from "./metric-cards";
+
+// Literal public B data, independent of the financial projector, clock or IO.
+function money(value: string | null, changes: Partial<HomepageV25Metric> = {}): HomepageV25Metric {
+  return { value, available: value !== null, coverage: { total: 3, available: value === null ? 0 : 3 }, reasons: [],
+    money: { originalByCurrency: value === null ? {} : { CNY: value }, targetCurrency: "CNY", conversion: "same-currency", fx: null }, ...changes };
+}
+function bundle(): HomepageV25SeriesBundle {
+  const point: HomepageV25BoundaryPoint = { key: "2026-10-02", requestedAt: "2026-10-02", businessDate: "2026-10-02",
+    effectiveCursor: "2026-10-02T15:59:59Z", boundaryPrecision: "day", state: "value", plottable: true,
+    net: money("18420.567800"), periodRealized: money("12240.5678"), unrealizedChange: money("6180"),
+    openingUnrealized: money("900"), closingUnrealized: money("7080"), marketValue: money("888"), unrealizedNet: money("777"),
+    lifetimeRealizedNet: money("666"), lifetimeNet: money("555"), openFees: money("1"), periodFees: money("640"),
+    instruments: [], quoteCoverage: {}, lifetimeCoverage: [], reasons: [],
+    fxCoverage: { state: "not-required", businessDate: "2026-10-02", observationIds: [], requiredPairs: [], pairKnowledge: {}, reasons: [] } };
+  return { sourceId: "source-1", requestGeneration: "g1", revisions: { trades: "t1", metadata: "m1", quotes: "q1", fx: "f1" },
+    policies: { finance: "F3-2026-10-23", feePool: "F3-canonical-prefix", feeFacts: "P2-incurred-knowledge-1", calendar: "exchange-2010-2030-F3",
+      dailyCoverage: "P2-strict-completed-1", fx: "P2-historical-pair-knowledge-1", quoteKnowledgeMode: "retrospective-completed-session" },
+    scope: { nature: "live", simulationRunId: null, includedExecutions: 1, excludedExecutions: 0, excludedByReason: {} },
+    boundary: { businessTimezone: "Asia/Shanghai", asOf: "2026-10-23T08:00:00Z", periodStart: "2026-10-01", requestedEnd: "2026-10-02", effectiveEnd: "2026-10-02" },
+    points: [point], periodSummary: point, summaryState: "value", tooltipFields: ["marketValue", "unrealizedNet", "lifetimeRealizedNet", "lifetimeNet", "net", "periodFees"], feeFacts: [],
+    current: { asOf: "2026-10-23T08:00:00Z", currentMarketValue: money("260102.123400"), currentUnrealized: money("23153.2500"), currentOpenFees: money("4"),
+      instruments: [], quoteCoverage: {}, fxCoverage: { state: "not-required", businessDate: "2026-10-23", observationIds: [], requiredPairs: [], pairKnowledge: {}, reasons: [] } } };
+}
+function frozen<T>(value: T): T {
+  if (value && typeof value === "object") { Object.values(value).forEach(frozen); Object.freeze(value); }
+  return value;
+}
+const ready = { kind: "ready" } as const;
+const card = (name: string) => screen.getByRole("article", { name });
+const value = (name: string) => within(card(name)).getByTestId("hp-metric-value");
+const trigger = (name: string, action = "口径详情") => screen.getByRole("button", { name: new RegExp(`^${name}，${action}，`) });
+afterEach(cleanup);
+
+describe("four controlled homepage metric readouts", () => {
+  it("M01–04 reads the three period fields and the separate current market value in visual order", () => {
+    render(<MetricCards series={bundle()} reportCurrency="CNY" status={ready} />);
+    expect(screen.getAllByRole("heading", { level: 3 }).map(node => node.textContent)).toEqual([
+      "期间净盈亏(CNY)", "期间已实现(CNY)", "期间浮盈变动(CNY)", "当前持仓市值(CNY)",
+    ]);
+    expect(value("期间净盈亏")).toHaveTextContent("+1.84 万");
+    expect(value("期间已实现")).toHaveTextContent("+1.22 万");
+    expect(value("期间浮盈变动")).toHaveTextContent("+6,180.00");
+    expect(value("当前持仓市值")).toHaveTextContent("26.01 万");
+    expect(value("当前持仓市值")).toHaveAttribute("data-tone", "neutral");
+    expect(screen.queryByRole("dialog")).not.toBeInTheDocument();
+  });
+
+  it.each(["期间净盈亏", "期间已实现", "期间浮盈变动", "当前持仓市值"])("M01–04 %s opens its own exact readout and returns focus on close", async name => {
+    const user = userEvent.setup();
+    render(<MetricCards series={bundle()} reportCurrency="CNY" status={ready} />);
+    await user.click(trigger(name));
+    const dialog = screen.getByRole("dialog", { name: `${name} · 口径详情` });
+    expect(dialog).toHaveFocus();
+    expect(dialog).toHaveTextContent("覆盖数量");
+    expect(dialog).toHaveTextContent("3 / 3");
+    await user.click(within(dialog).getByRole("button", { name: "关闭详情" }));
+    expect(screen.queryByRole("dialog")).not.toBeInTheDocument();
+    expect(trigger(name)).toHaveFocus();
+  });
+
+  it("M05 tabs in order and opens with Enter/Space, then Escape restores the exact trigger", async () => {
+    const user = userEvent.setup();
+    render(<MetricCards series={bundle()} reportCurrency="CNY" status={ready} />);
