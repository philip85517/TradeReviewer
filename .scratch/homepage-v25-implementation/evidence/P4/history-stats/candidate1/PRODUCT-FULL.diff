+  position: fixed; z-index: 100; width: min(440px, calc(100vw - 48px)); max-height: calc(100dvh - 48px); overflow-y: auto; padding: 16px;
+  border: 1px solid #283448; border-radius: 8px; background: #162233; color: #e6edf7; box-shadow: 0 12px 32px #0006;
+  font: 14px/20px -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif; font-variant-numeric: tabular-nums; overflow-wrap: anywhere;
