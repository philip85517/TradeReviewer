+    high = max(0.0, max(values))
+    span = max(high - low, minimum_step)
+    padding = span * 0.1
+    low = math.floor((low - padding) / minimum_step) * minimum_step
+    high = math.ceil((high + padding) / minimum_step) * minimum_step
