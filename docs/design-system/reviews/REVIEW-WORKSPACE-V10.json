          {
            "actor": {
              "name": "Lin Zhou",
              "role": "commenter"
            },
            "anchors": [],
            "createdAt": "2026-10-23T14:38:56Z",
            "documentId": "REVIEW-WORKSPACE-V10",
            "fingerprint": "cdce2f77ae98dc435ea989fd030b0198da003cd4f245dcd02e25eeeaa6b9cbb5",
            "history": [
              {
                "action": "create",
                "actor": {
