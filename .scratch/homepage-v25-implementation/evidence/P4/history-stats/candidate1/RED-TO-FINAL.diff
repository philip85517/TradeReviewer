+.hp-history-stats__notice { color: #a8b6cb; }
+.hp-history-stats__notice--pending { color: #6ca8ff; }
+.hp-history-stats__notice--error { color: #ff8592; }
+/* Four cards retain318px at1326px and278.5px/B at1168px; each card needs at least240px. */
