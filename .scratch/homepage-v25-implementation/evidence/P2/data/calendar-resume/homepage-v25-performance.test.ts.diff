+    expect(batch.points[0].fxCoverage.requiredPairs).toEqual(["HKD/CNY"]);
+    expect(batch.current.fxCoverage.requiredPairs).toEqual(["HKD/CNY"]);
+    expect(batch.current.currentMarketValue.value).toBeNull();
