+describe("PerformanceChart mixed pointer and keyboard focus lifetime", () => {
+  it("keeps the current keyboard detail when the pointer leaves a point while the graph owns focus", () => {
+    vi.useFakeTimers();
+    render(<PerformanceChart series={ready()} reportCurrency="CNY" />);
+    fireEvent.mouseEnter(hit("2026-10-02")); tick(300);
+    act(() => graph().focus());
+    fireEvent.mouseLeave(hit("2026-10-02")); tick(100);
+    expect(detail()).toHaveTextContent("2026-10-02");
+    expect(graph()).toHaveFocus();
+  });
+
+  it("keeps the focused amount and its source when the pointer leaves its date point", () => {
+    vi.useFakeTimers();
+    render(<PerformanceChart series={ready()} reportCurrency="CNY" />);
+    fireEvent.mouseEnter(hit("2026-10-02")); tick(300);
+    act(() => graph().focus());
+    const amount = within(detail()).getByTestId("hp-chart-value-marketValue");
+    act(() => amount.focus());
+    fireEvent.mouseLeave(hit("2026-10-02")); tick(100);
+    expect(detail()).toHaveTextContent("原币：CNY 260,102.123400");
+    expect(amount).toHaveFocus();
+  });
+
+  it.each(["point", "detail"] as const)("keeps a source focused after %s leave queued a hide, then closes on focus exit", target => {
+    vi.useFakeTimers();
+    render(<><PerformanceChart series={ready()} reportCurrency="CNY" /><button type="button">图表之后</button></>);
+    fireEvent.mouseEnter(hit("2026-10-02")); tick(300);
+    const amount = within(detail()).getByTestId("hp-chart-value-marketValue");
+    fireEvent.mouseLeave(target === "point" ? hit("2026-10-02") : detail()); tick(50);
+    act(() => amount.focus()); tick(100);
+    expect(detail()).toHaveTextContent("2026-10-02");
+    expect(detail()).toHaveTextContent("原币：CNY 260,102.123400");
+    expect(amount).toHaveFocus();
+    act(() => screen.getByRole("button", { name: "图表之后" }).focus());
+    expect(screen.queryByRole("tooltip")).not.toBeInTheDocument();
+  });
+
+  it("keeps a keyboard-focused gap reason when its pointer leaves and still allows Escape to close", () => {
+    vi.useFakeTimers();
+    render(<PerformanceChart series={bundle([point("2026-10-01", "0"), point("2026-10-02", null)])} reportCurrency="CNY" />);
+    const missing = screen.getByTestId("hp-chart-gap-2026-10-02");
+    act(() => missing.focus());
+    expect(missing).toHaveFocus();
+    fireEvent.mouseLeave(missing); tick(100);
+    expect(detail()).toHaveTextContent("行情缺失：未收到收盘价");
+    expect(missing).toHaveFocus();
+    fireEvent.keyDown(missing, { key: "Escape" });
+    expect(screen.queryByRole("tooltip")).not.toBeInTheDocument();
+    expect(missing).toHaveFocus();
+  });
+});
