+.hp-history-stats__affordance--error { opacity: 1; }
+.hp-history-stats__affordance--error { color: #ff8592; }
+.hp-history-stats__update { position: absolute; bottom: 0; right: 10px; color: var(--hp-blue, #6ca8ff); font-size: 12px; line-height: 16px; }
