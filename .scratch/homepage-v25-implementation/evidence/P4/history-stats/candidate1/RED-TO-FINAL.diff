+  font-variant-numeric: tabular-nums;
+}
+.hp-history-stats__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
+.hp-history-stats .hp-history-stats__card {
+  container: hp-history-card / inline-size;
+  position: relative;
+  box-sizing: border-box;
+  min-width: 0;
+  min-height: 88px;
+  border: 1px solid var(--hp-line, #283448);
+  border-radius: 10px;
+  background: var(--hp-surface, #111a26);
+}
+.hp-history-stats__content { box-sizing: border-box; height: 86px; padding: 12px 19px; }
+.hp-history-stats .hp-history-stats__card h3 {
+  overflow: hidden; margin: 0 58px 0 0; color: var(--hp-secondary, #a8b6cb);
+  font-family: inherit; font-size: 14px; font-weight: 400; line-height: 20px; white-space: nowrap; text-overflow: ellipsis;
+}
+.hp-history-stats__currency { font-size: 12px; }
+.hp-history-stats__readings { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; min-width: 0; margin-top: 4px; animation: hp-history-readings-in 150ms ease-out; }
+.hp-history-stats .hp-history-stats__value { display: flex; min-width: 0; margin: 0; font-size: 28px; font-weight: 600; line-height: 34px; white-space: nowrap; }
+.hp-history-stats .hp-history-stats__card--winRate .hp-history-stats__value { flex: 0 0 auto; max-width: 58%; }
+.hp-history-stats__number { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
+.hp-history-stats__unit { flex: 0 0 auto; white-space: pre; }
+.hp-history-stats__value--positive { color: #53d7a0; }
+.hp-history-stats__value--negative { color: #ff8592; }
+.hp-history-stats__value--neutral { color: var(--hp-text, #e6edf7); }
+.hp-history-stats__value--unknown { color: var(--hp-secondary, #a8b6cb); }
+.hp-history-stats__ratio { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; flex: 0 1 auto; min-width: 0; color: var(--hp-secondary, #a8b6cb); font-size: 11px; line-height: 16px; text-align: right; white-space: nowrap; }
+.hp-history-stats__ratio-count { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
+.hp-history-stats__ratio-prefix { display: none; }
+.hp-history-stats button.hp-history-stats__trigger,
+.hp-history-stats .hp-history-stats__trigger:hover:not(:disabled),
+.hp-history-stats .hp-history-stats__trigger:active:not(:disabled) {
+  position: absolute; inset: 0; display: block; width: 100%; height: 100%; padding: 0; border: 0; border-radius: 10px;
+  background: transparent; color: #6ca8ff; cursor: pointer; font: inherit;
+}
+.hp-history-stats .hp-history-stats__trigger:focus-visible { outline: 2px solid #a9c8ff; outline-offset: 2px; }
+.hp-history-stats__affordance { position: absolute; top: 8px; right: 8px; padding: 2px 4px; border-radius: 4px; background: #162233; font-size: 12px; line-height: 16px; opacity: 0; transition: opacity 120ms ease, color 120ms ease, background-color 120ms ease; }
