+.hp-history-stats__detail-header button:hover { color: #e6edf7; background: #1c2b42; }
+.hp-history-stats__detail-header button:focus-visible { outline: 2px solid #a9c8ff; outline-offset: 2px; }
+.hp-history-stats__facts { display: grid; grid-template-columns: 90px minmax(0, 1fr); gap: 8px 12px; margin: 12px 0 0; }
+.hp-history-stats__facts dt { color: #a8b6cb; }
+.hp-history-stats__facts dd { min-width: 0; margin: 0; text-align: right; }
+.hp-history-stats__facts dd span { display: block; }
+.hp-history-stats__reasons { margin: 12px 0 0; padding-left: 18px; color: #a8b6cb; }
+.hp-history-stats__notice { color: #a8b6cb; }
+.hp-history-stats__notice--pending { color: #6ca8ff; }
+.hp-history-stats__notice--error { color: #ff8592; }
+/* Four cards retain318px at1326px and278.5px/B at1168px; each card needs at least240px. */
+@container hp-history-stats (width < 1014px) { .hp-history-stats__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+@container hp-history-stats (width < 498px) { .hp-history-stats__grid { grid-template-columns: minmax(0, 1fr); } }
+/* The card owns A/B selection, including when embedded in a narrow desktop container. */
+@container hp-history-card (width < 298px) {
+  .hp-history-stats__content { height: 102px; }
+  .hp-history-stats__ratio { grid-template-columns: minmax(0, 1fr); }
+  .hp-history-stats__ratio-prefix { position: absolute; right: 0; bottom: calc(100% + 4px); display: block; }
+  .hp-history-stats__ratio-suffix { display: none; }
+}
+@media (pointer: coarse) { .hp-history-stats__detail-header button { flex-basis: 44px; width: 44px; height: 44px; } }
